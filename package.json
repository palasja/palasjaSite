{
  "name": "palasja",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "contracts": "npm --prefix ./contracts/ run dev",
    "contracts:i": "npm --prefix contracts/ install",
    "contracts:build": "npm --prefix ./contracts/ run build",
    "contractsApi": "npm --prefix ./contractsApi/ run start",
    "contractsApi:i": "npm --prefix ./contractsApi/ install",
    "palasja": "npm --prefix ./palasja/ run dev",
    "palasja:i": "npm --prefix ./palasja/ install",
    "palasja:build": "npm --prefix ./palasja/ run build",
    "gusmaryApi": "npm --prefix ./gusmaryApi/ run start",
    "gusmaryApi:i": "npm --prefix ./gusmaryApi/ install",
    "gusmaryAdmin": "npm --prefix ./GusMayHairAdmin/ run dev",
    "gusmaryAdmin:i": "npm --prefix ./GusMayHairAdmin/ install",
    "gusmaryAdmin:build": "npm --prefix ./GusMayHairAdmin/ run build",
    "gusmary": "npm --prefix ./gusMaryHairSSR/ run dev",
    "gusmary:i": "npm --prefix ./gusMaryHairSSR/ install",
    "gusmary:build": "npm --prefix ./gusMaryHairSSR/ run build",
    "all:i": "concurrently \"npm install\" \"npm run contracts:i\" \"npm run contractsApi:i\" \"npm run gusmaryApi:i\" \"npm run gusmaryAdmin:i\" \"npm run gusmary:i\" \"npm run palasja:i\"",
    "all:build": "concurrently \"npm run contracts:build\"  \"npm run gusmaryAdmin:build\" \"npm run gusmary:build\" \"npm run palasja:build\"",
    "all": "concurrently \"npm run contracts\" \"npm run contractsApi\" \"npm run gusmaryApi\" \"npm run gusmaryAdmin\" \"npm run gusmary\" \"npm run palasja\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
