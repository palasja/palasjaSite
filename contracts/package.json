{
  "name": "palasja",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .tsx,.ts --fix",
    "preview:local": "vite preview",
    "pretier:check": "prettier . --check",
    "pretier:fix": "prettier . --write",
    "lp:check": "npm run lint && npm run pretier:check",
    "lp:fix": "npm run lint:fix && npm run pretier:fix",
    "contractsApi": "npm --prefix ../contractsApi/ run start",
    "gusmaryApi": "npm --prefix ../gusmaryApi/ run start",
    "gusmaryAdmin": "npm --prefix ../GusMayHairAdmin/ run dev",
    "gusmary": "npm --prefix ../gusMaryHairSSR/ run dev",
    "palasja": "npm --prefix ../palasja/ run dev",
    "contracts:i": "npm install",
    "contractsApi:i": "npm --prefix ../contractsApi/ install",
    "gusmaryApi:i": "npm --prefix ../gusmaryApi/ install",
    "gusmaryAdmin:i": "npm --prefix ../GusMayHairAdmin/ install",
    "gusmary:i": "npm --prefix ../gusMaryHairSSR/ install",
    "palasja:i": "npm --prefix ../palasja/ install",
    "all:i": "concurrently \"npm run contracts:i\" \"npm run contractsApi:i\" \"npm run gusmaryApi:i\" \"npm run gusmaryAdmin:i\" \"npm run gusmary:i\" \"npm run palasja:i\"",
    "all": "concurrently \"npm run dev\" \"npm run contractsApi\" \"npm run gusmaryApi\" \"npm run gusmaryAdmin\" \"npm run gusmary\" \"npm run palasja\""
  },
  "dependencies": {
    "-": "^0.0.1",
    "@reduxjs/toolkit": "^2.8.2",
    "number-to-words-ru": "^2.4.1",
    "paper-css": "^0.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.3",
    "react-redux": "^9.2.0",
    "react-router": "^7.6.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
